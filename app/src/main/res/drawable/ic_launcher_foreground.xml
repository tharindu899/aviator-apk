<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108 × 108 dp viewport.
    Safe zone: inner 66 dp circle (radius 33 from centre 54,54).
    Background: @color/ic_launcher_background = #0F172A (dark navy).

    Design:
      • Two radial glow blobs (purple centre, pink near nose)
      • Rising exponential trail with purple→pink gradient stroke
      • Top-down airplane: plane faces RIGHT in path coords,
        then the <group rotation="-45"> tilts it upper-right in the viewport.
        Gradient coordinates are in VIEWPORT space, so after rotation:
          nose  ≈ (68, 40) → pink (#F9A8D4)
          tail  ≈ (40, 68) → dark purple (#6D28D9)
      • Cockpit highlight, nose glow dot + pulse ring, sparkle dots along trail
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Centre purple radial glow ──────────────────────────────────── -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0"   android:color="#AA5B21B6"/>
                <item android:offset="1"   android:color="#005B21B6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── Upper-right (nose area) pink radial glow ───────────────────── -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                android:type="radial"
                android:centerX="72"
                android:centerY="36"
                android:gradientRadius="20">
                <item android:offset="0"   android:color="#66BE185D"/>
                <item android:offset="1"   android:color="#00BE185D"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── Subtle dot grid (5 × 5) ───────────────────────────────────── -->
    <!-- Row y=26 -->
    <path android:pathData="M26,26 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M40,26 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M54,26 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M68,26 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#228B5CF6"/>
    <path android:pathData="M82,26 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <!-- Row y=40 -->
    <path android:pathData="M26,40 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M40,40 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M54,40 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M82,40 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <!-- Row y=54 -->
    <path android:pathData="M26,54 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M40,54 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M54,54 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M68,54 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M82,54 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <!-- Row y=68 -->
    <path android:pathData="M26,68 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M40,68 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#228B5CF6"/>
    <path android:pathData="M54,68 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M68,68 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M82,68 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <!-- Row y=82 -->
    <path android:pathData="M26,82 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M40,82 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M54,82 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M68,82 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>
    <path android:pathData="M82,82 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#338B5CF6"/>

    <!-- ── Trail: wide soft glow pass ─────────────────────────────────── -->
    <path
        android:pathData="M24,86 Q36,73 47,62 Q57,51 64,44 Q67,41 69,39"
        android:fillColor="#00000000"
        android:strokeWidth="11"
        android:strokeAlpha="0.11"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                android:type="linear"
                android:startX="24" android:startY="86"
                android:endX="69"   android:endY="39">
                <item android:offset="0"   android:color="#006D28D9"/>
                <item android:offset="1"   android:color="#FFA855F7"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── Trail: main coloured stroke ───────────────────────────────── -->
    <path
        android:pathData="M24,86 Q36,73 47,62 Q57,51 64,44 Q67,41 69,39"
        android:fillColor="#00000000"
        android:strokeWidth="3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                android:type="linear"
                android:startX="24" android:startY="86"
                android:endX="69"   android:endY="39">
                <item android:offset="0"    android:color="#006D28D9"/>
                <item android:offset="0.45" android:color="#99A855F7"/>
                <item android:offset="1"    android:color="#FFEC4899"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── Sparkle dots along the trail ───────────────────────────────── -->
    <!-- dot at ~(36, 73) -->
    <path android:pathData="M34,73 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" android:fillColor="#889333EA"/>
    <!-- dot at ~(47, 62) -->
    <path android:pathData="M45,62 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z" android:fillColor="#88A855F7"/>
    <!-- dot at ~(57, 51) -->
    <path android:pathData="M55,51 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" android:fillColor="#88C084FC"/>

    <!-- ── Plane: faces RIGHT in path-coords, -45° rotation → upper-right ── -->
    <!--
        Local coordinate system (before rotation, pivot 54,54):
          Nose:          x=74, y=54  → viewport ≈ (68, 40)  — pink end
          Tail centre:   x=34, y=54  → viewport ≈ (40, 68)  — purple end
          Upper-wing tip: x=51, y=37 → viewport ≈ (40, 44)
          Lower-wing tip: x=51, y=71 → viewport ≈ (64, 70)

        Gradient startX/endX/Y are in VIEWPORT space and remain fixed while
        the shapes rotate, giving nose=pink, tail=dark-purple automatically.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">

        <!-- Fuselage -->
        <path android:pathData="M74,54 L67,52.3 L37,52.8 L34,54 L37,55.2 L67,55.7 Z">
            <aapt:attr name="android:fillColor">
                <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                    android:type="linear"
                    android:startX="68" android:startY="39"
                    android:endX="40"   android:endY="69">
                    <item android:offset="0"    android:color="#FFF9A8D4"/>
                    <item android:offset="0.35" android:color="#FFC084FC"/>
                    <item android:offset="1"    android:color="#FF6D28D9"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Upper wing (swept back) -->
        <path android:pathData="M59,52.5 L51,37 L44,38.5 L49.5,52.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                    android:type="linear"
                    android:startX="68" android:startY="39"
                    android:endX="40"   android:endY="69">
                    <item android:offset="0"    android:color="#FFF9A8D4"/>
                    <item android:offset="0.35" android:color="#FFC084FC"/>
                    <item android:offset="1"    android:color="#FF6D28D9"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Lower wing (swept back, mirror of upper) -->
        <path android:pathData="M59,55.5 L51,71 L44,69.5 L49.5,55.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                    android:type="linear"
                    android:startX="68" android:startY="39"
                    android:endX="40"   android:endY="69">
                    <item android:offset="0"    android:color="#FFF9A8D4"/>
                    <item android:offset="0.35" android:color="#FFC084FC"/>
                    <item android:offset="1"    android:color="#FF6D28D9"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Upper tail fin -->
        <path android:pathData="M37,52.5 L32,46.5 L34.5,49.5 L37,52.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                    android:type="linear"
                    android:startX="68" android:startY="39"
                    android:endX="40"   android:endY="69">
                    <item android:offset="0"    android:color="#FFF9A8D4"/>
                    <item android:offset="0.35" android:color="#FFC084FC"/>
                    <item android:offset="1"    android:color="#FF6D28D9"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Lower tail fin -->
        <path android:pathData="M37,55.5 L32,61.5 L34.5,58.5 L37,55.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient xmlns:android="http://schemas.android.com/apk/res/android"
                    android:type="linear"
                    android:startX="68" android:startY="39"
                    android:endX="40"   android:endY="69">
                    <item android:offset="0"    android:color="#FFF9A8D4"/>
                    <item android:offset="0.35" android:color="#FFC084FC"/>
                    <item android:offset="1"    android:color="#FF6D28D9"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Cockpit highlight (oval near nose) -->
        <path
            android:pathData="M62.5,54 a3.5,2.2 0 1,0 7,0 a3.5,2.2 0 1,0 -7,0 Z"
            android:fillColor="#33FFFFFF"/>

    </group>

    <!-- ── Nose glow dot at viewport ≈ (68, 40) ──────────────────────── -->
    <path
        android:pathData="M65.5,40 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z"
        android:fillColor="#FFEC4899"/>

    <!-- Nose pulse ring (inner) -->
    <path
        android:pathData="M63,40 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#88EC4899"
        android:strokeWidth="1.2"/>

    <!-- Nose pulse ring (outer, faint) -->
    <path
        android:pathData="M60.5,40 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#44A855F7"
        android:strokeWidth="0.8"/>

</vector>
