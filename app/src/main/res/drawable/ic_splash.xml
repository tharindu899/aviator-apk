<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon + Splash screen animated icon.

    Android notification small icons must be white on transparent — the system
    tints them automatically. This drawable uses white fills so it looks correct
    both as a notification icon and as the splash screen centre icon on the
    dark navy (#0F172A) background.

    The airplane silhouette matches ic_launcher_foreground so the brand is
    consistent across all surfaces.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rising trail (light, white) -->
    <path
        android:pathData="M24,86 Q36,73 47,62 Q57,51 64,44 Q67,41 69,39"
        android:fillColor="#00000000"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"/>

    <!-- Plane: faces right, rotated -45° → points upper-right -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">

        <!-- Fuselage -->
        <path
            android:pathData="M74,54 L67,52.3 L37,52.8 L34,54 L37,55.2 L67,55.7 Z"
            android:fillColor="#FFFFFFFF"/>

        <!-- Upper wing -->
        <path
            android:pathData="M59,52.5 L51,37 L44,38.5 L49.5,52.5 Z"
            android:fillColor="#FFFFFFFF"/>

        <!-- Lower wing -->
        <path
            android:pathData="M59,55.5 L51,71 L44,69.5 L49.5,55.5 Z"
            android:fillColor="#FFFFFFFF"/>

        <!-- Upper tail fin -->
        <path
            android:pathData="M37,52.5 L32,46.5 L34.5,49.5 L37,52.5 Z"
            android:fillColor="#FFFFFFFF"/>

        <!-- Lower tail fin -->
        <path
            android:pathData="M37,55.5 L32,61.5 L34.5,58.5 L37,55.5 Z"
            android:fillColor="#FFFFFFFF"/>

        <!-- Cockpit cutout (darker to suggest a window) -->
        <path
            android:pathData="M62.5,54 a3.5,2.2 0 1,0 7,0 a3.5,2.2 0 1,0 -7,0 Z"
            android:fillColor="#33000000"/>

    </group>

    <!-- Nose dot -->
    <path
        android:pathData="M65.5,40 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z"
        android:fillColor="#FFFFFFFF"/>

</vector>
