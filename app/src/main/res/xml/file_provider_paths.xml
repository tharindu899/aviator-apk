<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path declarations for Aviator Predictor.

    <external-files-path> → Context.getExternalFilesDir()
        Maps:  /sdcard/Android/data/com.aviator.predictor/files/Downloads/
        Used by UpdateInstaller.startDownload() (primary strategy)

    <external-path> → Environment.getExternalStorageDirectory()
        Maps:  /sdcard/Download/   and   /sdcard/Downloads/
        Fallback in case DownloadManager resolves to public storage on some ROMs.

    Both entries are needed so installApk() can serve whichever path
    resolveFile() returns without throwing IllegalArgumentException.
-->
<paths>
    <!-- Primary: app-private external Downloads (no storage permission needed) -->
    <external-files-path
        name="downloads"
        path="Downloads/" />

    <!-- Fallback A: public Download folder (some DownloadManager implementations) -->
    <external-path
        name="public_download"
        path="Download/" />

    <!-- Fallback B: public Downloads folder (alternate spelling on some devices) -->
    <external-path
        name="public_downloads"
        path="Downloads/" />

    <!-- Fallback C: root of external storage (covers any sub-path) -->
    <external-path
        name="external_root"
        path="." />
</paths>
